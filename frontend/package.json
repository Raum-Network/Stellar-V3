{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:release": "NEXT_PUBLIC_BUILD_TIME=${NEXT_PUBLIC_BUILD_TIME:-$(date -u +%Y-%m-%dT%H:%M:%SZ)} next build",
    "start": "next start -p 3105",
    "analyze": "ANALYZE=true next build",
    "budget:js": "node scripts/check-js-budget.mjs",
    "lint": "next lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "security:scan": "bash scripts/scan-secrets.sh",
    "security:trace-bundle-secret": "bash scripts/trace-bundle-secret.sh PASSWO",
    "audit:live:surface": "squirrel audit https://clmm.raum.network -C surface --format llm --refresh",
    "audit:live:full": "squirrel audit https://clmm.raum.network -C full --format llm --refresh",
    "audit:live:diff": "squirrel report --diff aa1f07cf --format llm"
  },
  "dependencies": {
    "@albedo-link/intent": "^0.13.0",
    "@ledgerhq/hw-app-str": "^7.4.0",
    "@lobstrco/signer-extension-api": "^2.0.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^14.1.1",
    "@tanstack/react-query": "^5.90.20",
    "@walletconnect/core": "^2.23.4",
    "@walletconnect/sign-client": "^2.23.4",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "crypto-browserify": "^3.12.1",
    "factory": "file:src/contracts/factory",
    "framer-motion": "^12.29.2",
    "governance": "file:src/contracts/governance",
    "lenis": "^1.1.16",
    "lucide-react": "^0.563.0",
    "next": "^14.2.16",
    "pool": "file:src/contracts/pool",
    "position_manager": "file:src/contracts/position_manager",
    "process": "^0.11.10",
    "qrcode.react": "^4.2.0",
    "react": "^18",
    "react-dom": "^18",
    "react-is": "^19.2.4",
    "recharts": "^3.7.0",
    "router": "file:src/contracts/router",
    "stream-browserify": "^3.0.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.35",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^14.2.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.16",
    "jsdom": "^24.1.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^1.6.0"
